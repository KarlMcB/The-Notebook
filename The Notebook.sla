        <MASTEROBJECT XPOS="120.9375" YPOS="39.9375" OwnPage="1" ItemID="291454290" PTYPE="4" WIDTH="351" HEIGHT="22.5" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L351 0 L351 22.5 L0 22.5 L0 0 Z" copath="M0 0 L351 0 L351 22.5 L0 22.5 L0 0 Z" OnMasterPage="Normal Right" gXpos="62176872.9375" gYpos="2555053096.26258" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
