        <MASTEROBJECT XPOS="276.75" YPOS="579.375" OwnPage="2" ItemID="290785618" PTYPE="4" WIDTH="54" HEIGHT="21.375" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L54 0 L54 21.375 L0 21.375 L0 0 Z" copath="M0 0 L54 0 L54 21.375 L0 21.375 L0 0 Z" OnMasterPage="Chapter Opening" gXpos="1163724.75" gYpos="579.375" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
